{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JuneYaooo/rea-video/reel.schema.json",
  "title": "Reel v1 front matter",
  "description": "Front matter of the files in a Reel package (docs/reel.md). Unknown fields are allowed everywhere: readers ignore what they do not know.",
  "$defs": {
    "version": {"const": 1},
    "label": {
      "description": "How the base picture was made",
      "enum": ["live_action", "ai_video", "avatar", "cg_3d", "code_render", "screen_capture", "still_motion", "static_hold", "anim_2d", "stop_motion", "film_footage"]
    },
    "camera": {"enum": ["static", "static_with_subject_motion", "planar_zoom_pan", "handheld_like", "smooth_move", "unknown"]},
    "prob": {"type": "number", "minimum": 0, "maximum": 1},
    "tokens": {"type": "integer", "minimum": 0},
    "path": {"type": "string", "description": "Relative to the package root", "pattern": "^(?!/)(?!.*\\.\\./)"},

    "card": {
      "type": "object",
      "required": ["reel", "name", "description", "source", "shots", "made_mix", "lang"],
      "properties": {
        "reel": {"$ref": "#/$defs/version"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1, "maxLength": 200},
        "source": {
          "type": "object",
          "required": ["file", "duration"],
          "properties": {
            "file": {"type": "string"},
            "duration": {"type": "number", "minimum": 0},
            "size": {"type": "string", "pattern": "^\\d+x\\d+$"},
            "fps": {"type": "number", "minimum": 0},
            "aspect": {"type": "string"}
          }
        },
        "shots": {"type": "integer", "minimum": 0},
        "confidence": {"$ref": "#/$defs/prob"},
        "made_mix": {"type": "object", "propertyNames": {"$ref": "#/$defs/label"}, "additionalProperties": {"$ref": "#/$defs/prob"}},
        "readers": {"type": "array", "items": {"enum": ["tools", "vlm", "agent", "user"]}, "uniqueItems": true},
        "open_questions": {"type": "integer", "minimum": 0},
        "lang": {"type": "string", "pattern": "^[a-z]{2}(-[A-Za-z]+)?$"}
      }
    },

    "part": {
      "type": "object",
      "required": ["reel", "part", "tokens"],
      "properties": {
        "reel": {"$ref": "#/$defs/version"},
        "part": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "timeline, content, cast, sound, look, packaging, remake; more may be added"},
        "tokens": {"$ref": "#/$defs/tokens"},
        "shots": {"type": "integer", "minimum": 0}
      },
      "if": {"properties": {"part": {"const": "timeline"}}},
      "then": {"required": ["shots"]}
    },

    "shot": {
      "type": "object",
      "required": ["reel", "part", "shot", "time", "inferred", "tokens"],
      "properties": {
        "reel": {"$ref": "#/$defs/version"},
        "part": {"const": "shot"},
        "shot": {"type": "integer", "minimum": 1},
        "time": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 2, "maxItems": 2},
        "camera": {"$ref": "#/$defs/camera"},
        "overlays": {"type": "array", "items": {"type": "string"}, "uniqueItems": true,
                     "description": "subtitle, title, label, huazi, static_graphic, layout_template, animated_sticker, static_sticker, pip; more may be added"},
        "inferred": {
          "type": "object",
          "required": ["made", "p"],
          "properties": {
            "made": {"$ref": "#/$defs/label"},
            "p": {"$ref": "#/$defs/prob"},
            "alternatives": {"type": "object", "propertyNames": {"$ref": "#/$defs/label"}, "additionalProperties": {"$ref": "#/$defs/prob"}},
            "decided_by": {"enum": ["deterministic", "fused", "fused_agent", "user"]},
            "real_material": {"type": "boolean"}
          }
        },
        "flags": {"type": "array", "items": {"enum": ["uncertain", "disputed", "low_confidence"]}, "uniqueItems": true},
        "frames": {
          "type": "object",
          "properties": {"sheet": {"$ref": "#/$defs/path"}, "first": {"$ref": "#/$defs/path"}, "last": {"$ref": "#/$defs/path"}}
        },
        "tokens": {"$ref": "#/$defs/tokens"}
      }
    }
  }
}
